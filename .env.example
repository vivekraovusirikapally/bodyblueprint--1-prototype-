# --- Front end (Vite) ---
# Where the API lives. Default "/api" (proxied to the server in dev). Set to "off" for local-only mode.
# VITE_API_URL=/api

# --- Back end (Express + SQLite) ---
# PORT=3001
# HOST=127.0.0.1
# DB_PATH=./backend/data/bodyblueprint.db
# Optional shared secret; when set, every /api request except /api/health must send an X-API-Key header.
# API_KEY=change-me
# Comma-separated list of origins allowed by CORS (not needed when using the Vite proxy).
# CORS_ORIGINS=http://localhost:5173
