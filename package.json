{
  "name": "bodyblueprint",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "vite",
    "server": "node backend/src/server.js",
    "dev:all": "concurrently -n web,api \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "node --test backend/test",
    "test:all": "npm run test && npm run test:server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "express": "^4.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.8"
  }
}
